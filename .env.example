# MySQL connection (required for admin + forms). Use a pooled URL on Vercel (e.g. PlanetScale / Neon / Railway).
# DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/mpmodels"

# Signs admin session cookies. REQUIRED in production — min 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# First admin account, created/updated by `npm run db:seed`.
ADMIN_EMAIL="admin@mpmodels.com"
ADMIN_PASSWORD=""

# Optional: public site URL (used for absolute links when set)
# NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"
