# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env / secrets — never commit real credentials
.env
.env.*
!.env.example

/.tmp
.tmp-check.js

# admin uploads (model portfolio, snaps and videos)
/uploads
/uploads/**

# vercel / local tooling
.vercel
.playwright*
playwright-report

# typescript
*.tsbuildinfo
next-env.d.ts
